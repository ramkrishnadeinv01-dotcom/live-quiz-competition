rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAcademicAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'ramkrishnadeinv.01@gmail.com';
    }

    match /academic-materials/{adminUid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if isAcademicAdmin()
        && request.auth.uid == adminUid
        && request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAcademicAdmin() && request.auth.uid == adminUid;
    }
  }
}
